[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "default-deny",
      "namespace": "platform-lab"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": [
        "Ingress",
        "Egress"
      ]
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "reviewer-ingress",
      "namespace": "platform-lab"
    },
    "spec": {
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "gitops.platform/client": "allowed"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "role": "reviewer"
                }
              }
            }
          ],
          "ports": [
            {
              "port": 8080,
              "protocol": "TCP"
            }
          ]
        }
      ],
      "podSelector": {
        "matchLabels": {
          "app": "sre"
        }
      },
      "policyTypes": [
        "Ingress"
      ]
    }
  },
  {
    "apiVersion": "v1",
    "automountServiceAccountToken": false,
    "kind": "ServiceAccount",
    "metadata": {
      "name": "workload",
      "namespace": "platform-lab"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "sre",
      "namespace": "platform-lab"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "protocol": "TCP",
          "targetPort": "http"
        }
      ],
      "selector": {
        "app": "sre"
      },
      "type": "ClusterIP"
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "sre",
      "namespace": "platform-lab"
    },
    "spec": {
      "progressDeadlineSeconds": 60,
      "replicas": 1,
      "revisionHistoryLimit": 3,
      "selector": {
        "matchLabels": {
          "app": "sre"
        }
      },
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      },
      "template": {
        "metadata": {
          "annotations": {
            "gitops.platform/revision": "baseline"
          },
          "labels": {
            "app": "sre"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "args": [
                "--pod"
              ],
              "image": "gitops-sre:lab",
              "imagePullPolicy": "Never",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/health",
                  "port": "http"
                },
                "periodSeconds": 5,
                "timeoutSeconds": 1
              },
              "name": "sre",
              "ports": [
                {
                  "containerPort": 8080,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 2,
                "httpGet": {
                  "path": "/health",
                  "port": "http"
                },
                "periodSeconds": 2,
                "timeoutSeconds": 1
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "32Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              }
            }
          ],
          "securityContext": {
            "runAsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "serviceAccountName": "workload",
          "terminationGracePeriodSeconds": 5
        }
      }
    }
  }
]
